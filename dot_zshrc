gbg() {
  local dir=~/.config/ghostty/backgrounds
  local active="$dir/active.conf"

  if [ -n "$1" ]; then
    ln -sfn "$dir/$1.conf" "$active"
    echo "Switched to background $1"
  else
    # no argument: clear the background entirely
    rm -f "$active"
    : > "$active"
    echo "Background cleared"
  fi

  osascript -e 'tell application "System Events" to tell process "Ghostty" to click menu item "Reload Configuration" of menu "Ghostty" of menu bar 1'
}

